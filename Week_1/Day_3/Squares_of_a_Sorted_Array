class Solution {
public:
    vector<int> sortedSquares(vector<int>& nums) {
        int n=nums.size();
        vector<int> v(n);

        int s=0,e=n-1,i=n-1;
        while(s<=e){
            if(abs(nums[s])<abs(nums[e])){
                v[i--]=nums[e]*nums[e];
                e--;
            }
            else {
               v[i--]=nums[s]*nums[s];
                s++;
            }
           
        }

        return v;

        
    }
};
